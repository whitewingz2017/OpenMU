@page "/buff-durations"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using MUnique.OpenMU.Web.AdminPanel.Properties

<PageTitle>OpenMU: @Text("BuffDurations_Title")</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@Text("BuffDurations_Title")" />

<h1>@Text("BuffDurations_Title")</h1>
<p>@Text("BuffDurations_Description")</p>

@if (this._effects is null)
{
    <p>Loading...</p>
    return;
}

<input type="search" class="form-control mb-3" placeholder="@Text("BuffDurations_Filter")" aria-label="@Text("BuffDurations_Filter")"
       @bind="this._filter" @bind:event="oninput" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>@Text("BuffDurations_Effect")</th>
            <th style="width: 11rem;">@Text("BuffDurations_Seconds")</th>
            <th style="width: 11rem;">@Text("BuffDurations_PvpSeconds")</th>
            <th>@Text("BuffDurations_Scaling")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var effect in this.FilteredEffects)
        {
            <tr @key="effect">
                <td>@effect.Name <span class="text-muted">(@effect.Number)</span></td>
                <td>
                    <input type="number" class="form-control form-control-sm" min="0" step="1" aria-label="@Text("BuffDurations_Seconds")"
                           value="@effect.Duration!.ConstantValue.Value" @onchange="e => SetSeconds(effect.Duration!, e.Value)" />
                </td>
                <td>
                    @if (effect.DurationPvp is { } pvp)
                    {
                        <input type="number" class="form-control form-control-sm" min="0" step="1" aria-label="@Text("BuffDurations_PvpSeconds")"
                               value="@pvp.ConstantValue.Value" @onchange="e => SetSeconds(pvp, e.Value)" />
                    }
                    else
                    {
                        <span class="text-muted small">@Text("BuffDurations_SameAsNormal")</span>
                    }
                </td>
                <td class="small text-muted">@ScalingText(effect)</td>
            </tr>
        }
    </tbody>
</table>

<button type="button" class="btn btn-primary me-1" @onclick="this.SaveAsync">@Resources.SaveChanges</button>
<button type="button" class="btn btn-secondary" @onclick="this.DiscardAsync">@Resources.DiscardChanges</button>
