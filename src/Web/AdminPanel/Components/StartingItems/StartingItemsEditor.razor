@using MUnique.OpenMU.GameLogic.PlugIns
@using MUnique.OpenMU.Persistence.Initialization.PlugIns.CharacterCreated
@using Resources = MUnique.OpenMU.Web.Shared.Properties.Resources

@foreach (var profile in this.Item.Classes.OrderBy(c => (byte)c.Class))
{
    var expanded = this._expanded.Contains(profile.Class);
    <div class="card mb-3" @key="profile.Class">
        <h5 class="card-header d-flex align-items-center gap-2">
            <span class="me-auto">@ClassCaption(profile.Class)</span>
            @if (profile.Enabled)
            {
                <span class="badge bg-success">@AdministrationResources.StartingEnabled</span>
            }
            else
            {
                <span class="badge bg-secondary">@AdministrationResources.StartingEnabled: -</span>
            }
            <span class="badge bg-info text-dark">@AdministrationResources.StartingItemsList: @profile.Items.Sum(i => i.Quantity)</span>
            <span class="badge bg-warning text-dark">Zen: @profile.StartingZen.ToString("N0")</span>
            <button type="button" class="btn btn-outline-info" @onclick="() => this.ToggleExpanded(profile.Class)">
                @(expanded ? Resources.Collapse : string.Format(Resources.ExpandItems, profile.Items.Count))
            </button>
        </h5>
        @if (expanded)
        {
            <div class="card-body card-text">
                <BooleanField Label="@AdministrationResources.StartingEnabled" @bind-Value="profile.Enabled" />
                <BooleanField Label="@AdministrationResources.StartingReplaceLegacy" @bind-Value="profile.ReplaceLegacyItems" />
                <NumberField Label="@AdministrationResources.StartingZen" @bind-Value="profile.StartingZen" Min="0" />

                <h6 class="mt-3">@AdministrationResources.StartingItemsList</h6>
                <table class="table table-striped table-hover">
                    <tbody>
                        @foreach (var reward in profile.Items)
                        {
                            <tr @key="reward">
                                <td>
                                    <StartingItemEditor Reward="reward" Definitions="this.Definitions" />
                                </td>
                                <td class="text-end" style="width: 1%;">
                                    <button type="button" class="btn btn-danger" @onclick="() => profile.Items.Remove(reward)"><span class="oi oi-trash" aria-hidden="true"></span> @Resources.Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="border-bottom-0">
                                <button type="button" class="btn btn-primary" @onclick="() => AddItem(profile)">@Resources.AddValue</button>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
}
