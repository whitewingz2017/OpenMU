@using MUnique.OpenMU.GameLogic.Cosmetics
@using MUnique.OpenMU.Web.Shared.Properties

<p class="text-muted">@Text("ExcellentEffectHint")</p>

<details class="mb-3">
    <summary>@Text("Defaults")</summary>
    <NumberField Label="@Text("Sets")" @bind-Value="this.Item.ArmorPrice" Min="0" />
    <NumberField Label="@Text("Wings")" @bind-Value="this.Item.WingPrice" Min="0" />
    <NumberField Label="@Text("Weapons")" @bind-Value="this.Item.WeaponPrice" Min="0" />
    <NumberField Label="@Text("Shields")" @bind-Value="this.Item.ShieldPrice" Min="0" />
    <NumberField Label="@Text("Pets")" @bind-Value="this.Item.PetPrice" Min="0" />
    <NumberField Label="@Text("Mounts")" @bind-Value="this.Item.MountPrice" Min="0" />
</details>

<details class="mb-3">
    <summary>@Text("GoblinDefaults")</summary>
    <NumberField Label="@Text("Sets")" @bind-Value="this.Item.GoblinArmorPrice" Min="0" />
    <NumberField Label="@Text("Wings")" @bind-Value="this.Item.GoblinWingPrice" Min="0" />
    <NumberField Label="@Text("Weapons")" @bind-Value="this.Item.GoblinWeaponPrice" Min="0" />
    <NumberField Label="@Text("Shields")" @bind-Value="this.Item.GoblinShieldPrice" Min="0" />
    <NumberField Label="@Text("Pets")" @bind-Value="this.Item.GoblinPetPrice" Min="0" />
    <NumberField Label="@Text("Mounts")" @bind-Value="this.Item.GoblinMountPrice" Min="0" />
</details>

<details id="skin-rental-prices" class="mb-3" open>
    <summary>@Text("RentalPrices")</summary>
    <p class="text-muted">@Text("RentalHint")</p>
    <NumberField Label="@Text("RentalOneDay")" @bind-Value="this.Item.RentalOneDayPrice" Min="0" />
    <NumberField Label="@Text("RentalThreeDays")" @bind-Value="this.Item.RentalThreeDaysPrice" Min="0" />
    <NumberField Label="@Text("RentalSevenDays")" @bind-Value="this.Item.RentalSevenDaysPrice" Min="0" />
</details>

@foreach (var category in Enum.GetValues<SkinShopCategory>())
{
    <details class="card mb-3" @key="category" open="@(category == SkinShopCategory.Sets)">
        <summary class="card-header">@Text(category.ToString())</summary>
        <div class="card-body">
            <label class="form-check mb-3">
                <input type="checkbox" class="form-check-input" checked="@(!this.Item.DisabledCategories.Contains(category))"
                       @onchange="args => this.SetCategoryEnabled(category, args.Value is true)" />
                @Text("CategoryEnabled")
            </label>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead><tr><th>@Text("Sell")</th><th>@Text("Item")</th><th>@Text("ExcellentEffect")</th>
                        @if (category == SkinShopCategory.Sets)
                        {
                            <th>@Text("AuraColor")</th>
                        }
                        <th>@Text("Price")</th><th>@Text("GoblinPrice")</th></tr></thead>
                    <tbody>
                        @foreach (var definition in this.Definitions.Where(d => FenrirMountRules.IsShopItem(d) && SkinShopSettings.Category(d) == category).OrderByDescending(d => this.Item.Items[(d.Group * 512) + d.Number].Enabled).ThenBy(d => d.Number))
                        {
                            var type = (definition.Group * 512) + definition.Number;
                            var sale = this.Item.Items[type];
                            <tr @key="type">
                                <td><InputCheckbox id="@($"skin-sale-{type}")" class="form-check-input" @bind-Value="sale.Enabled" aria-label="@(Text("Sell") + " " + definition.Name.ValueInNeutralLanguage)" /></td>
                                <td><label for="@($"skin-sale-{type}")">@definition.Name.ValueInNeutralLanguage</label> <small class="text-muted">(@definition.Group:@definition.Number)</small></td>
                                <td><InputCheckbox id="@($"skin-excellent-effect-{type}")" class="form-check-input" @bind-Value="sale.ExcellentEffect" aria-label="@(Text("ExcellentEffect") + " " + definition.Name.ValueInNeutralLanguage)" /></td>
                                @if (category == SkinShopCategory.Sets)
                                {
                                    <td>
                                        <InputSelect id="@($"skin-aura-{type}")" class="form-select" @bind-Value="sale.AuraColor"
                                                     aria-label="@(Text("AuraColor") + " " + definition.Name.ValueInNeutralLanguage)">
                                            @foreach (var color in Enum.GetValues<SkinAuraColor>().OrderBy(color => (int)color))
                                            {
                                                <option value="@color">@color</option>
                                            }
                                        </InputSelect>
                                    </td>
                                }
                                <td>
                                    <InputNumber id="@($"skin-price-{type}")" class="form-control" @bind-Value="sale.Price" min="0" max="@int.MaxValue" aria-label="@(Text("Price") + " " + definition.Name.ValueInNeutralLanguage)" />
                                    <ValidationMessage For="@(() => sale.Price)" />
                                </td>
                                <td>
                                    <InputNumber id="@($"skin-goblin-price-{type}")" class="form-control" @bind-Value="sale.GoblinPrice" min="0" max="@int.MaxValue" aria-label="@(Text("GoblinPrice") + " " + definition.Name.ValueInNeutralLanguage)" />
                                    <ValidationMessage For="@(() => sale.GoblinPrice)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </details>
}
